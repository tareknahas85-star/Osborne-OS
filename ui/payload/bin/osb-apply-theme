#!/usr/bin/python3
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from osb.theme import apply, HOME
m = sys.argv[1] if len(sys.argv) > 1 else (open(os.path.join(HOME, '.config/osborne/mode')).read().strip() if os.path.exists(os.path.join(HOME, '.config/osborne/mode')) else 'light')
apply(m)
