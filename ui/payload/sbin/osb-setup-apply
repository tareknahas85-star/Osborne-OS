#!/usr/bin/python3
"""Osborne OS first-boot helper (root, called by the setup wizard through sudo).
Reads JSON {name,user,password,tz,lang} on stdin, creates the account and prepares the encrypted data storage."""
import sys, os, re, json, subprocess, shutil, grp, pwd

def step(t): print('STEP ' + t, flush=True)
def fail(t, rc=1): print('ERROR ' + t, flush=True); sys.exit(rc)
def run(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)

if os.geteuid() != 0: fail('must run as root')
if os.path.exists('/var/lib/osborne/setup-done') and not os.environ.get('OSB_TEST'): fail('this device is already set up')
try: d = json.loads(sys.stdin.read())
except Exception: fail('bad request')
name = str(d.get('name', '')).strip()[:30]; user = str(d.get('user', '')).strip().lower(); pw = str(d.get('password', '')); tz = str(d.get('tz', '')) or 'UTC'; lang = d.get('lang', 'en')
if not name or not re.match(r'^[a-z][a-z0-9_-]{0,30}$', user) or user in ('root', 'osbsetup') or not pw or ':' in pw or '\n' in pw or ',' in name or ':' in name:
    fail('invalid name, username or password')
if not re.match(r'^[A-Za-z0-9_+./-]+$', tz) or not os.path.exists('/usr/share/zoneinfo/' + tz): tz = 'UTC'
HOME_SETUP = os.path.expanduser('~osbsetup') if 'osbsetup' in [p.pw_name for p in pwd.getpwall()] else ''

step('Creating your account...')
if run(['id', user]).returncode == 0: fail('that username already exists')
groups = [g for g in ('sudo', 'adm', 'audio', 'video', 'cdrom', 'plugdev', 'netdev', 'bluetooth', 'lpadmin', 'dip') if g in [x.gr_name for x in grp.getgrall()]]
r = run(['useradd', '-m', '-s', '/bin/bash', '-c', name, '-G', ','.join(groups), user])
if r.returncode != 0: fail('could not create the account: ' + (r.stderr or '').strip()[:80])
r = run(['chpasswd'], input='%s:%s\n' % (user, pw))
if r.returncode != 0: fail('could not set the password')
home = pwd.getpwnam(user).pw_dir; uid, gid = pwd.getpwnam(user).pw_uid, pwd.getpwnam(user).pw_gid

step('Saving your profile...')
cfg = os.path.join(home, '.config', 'osborne'); os.makedirs(cfg, exist_ok=True)
for f in ('profile', 'avatar', 'avatar.png'):
    src = os.path.join(HOME_SETUP, '.config', 'osborne', f) if HOME_SETUP else ''
    if src and os.path.isfile(src): shutil.copy(src, os.path.join(cfg, f))
open(os.path.join(cfg, 'profile'), 'w').write(name + '\n')
open(os.path.join(cfg, 'lang'), 'w').write(lang if lang in ('en', 'ar') else 'en')
mf = os.path.join(cfg, 'mode')
if not os.path.exists(mf): open(mf, 'w').write('light\n')
for root, dirs, files in os.walk(os.path.join(home, '.config')):
    os.chown(root, uid, gid)
    for f in files: os.chown(os.path.join(root, f), uid, gid)
os.chown(os.path.join(home, '.config'), uid, gid)
if lang == 'ar':
    run(['bash', '-c', 'grep -q "^ar_SY.UTF-8" /etc/locale.gen || sed -i "s/^# *ar_SY.UTF-8/ar_SY.UTF-8/" /etc/locale.gen; locale-gen >/dev/null 2>&1; true'])

step('Setting the time zone...')
try:
    if os.path.lexists('/etc/localtime'): os.remove('/etc/localtime')
    os.symlink('/usr/share/zoneinfo/' + tz, '/etc/localtime'); open('/etc/timezone', 'w').write(tz + '\n')
except Exception: pass
run(['timedatectl', 'set-timezone', tz])

data_note = ''
if not os.environ.get('OSB_TEST'):
    r = subprocess.run(['/usr/local/sbin/osb-data-setup', user], input=pw, capture_output=True, text=True)
    for ln in r.stdout.splitlines():
        if ln.startswith('STEP '): step(ln[5:])
    if r.returncode != 0: data_note = (r.stdout.strip().splitlines() or ['storage setup failed'])[-1]

os.makedirs('/var/lib/osborne', exist_ok=True); open('/var/lib/osborne/setup-done', 'w').write(user + '\n')
if data_note: open('/var/lib/osborne/data-error', 'w').write(data_note + '\n')
# hand the screen over to the new account (autologin once), then clean the temporary setup account
os.makedirs('/etc/lightdm/lightdm.conf.d', exist_ok=True)
open('/etc/lightdm/lightdm.conf.d/50-osb-setup.conf', 'w').write('[Seat:*]\nautologin-user=%s\nautologin-user-timeout=0\nautologin-session=openbox\nuser-session=openbox\n' % user)
if not os.environ.get('OSB_TEST'):
    step('Starting your desktop...')
    fin = ('sleep 2; systemctl restart lightdm; sleep 40; rm -f /etc/lightdm/lightdm.conf.d/50-osb-setup.conf /etc/sudoers.d/osb-setup /usr/share/xsessions/osb-setup.desktop; '
           'pkill -u osbsetup; sleep 1; userdel -rf osbsetup; true')
    subprocess.Popen(['systemd-run', '--no-block', '--unit=osb-setup-finish', 'bash', '-c', fin], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
print('STEP Done', flush=True)
